#!/bin/bash
# Submit one HyperQueue task per XYZ file to a running HQ server.
#
# Assumes you've already started the HQ server + worker(s) in your own SLURM
# job (the worker calls `hq worker start`). This script just enqueues work
# into that server from the login node.
#
# Workflow:
#   sbatch my_hq_worker.sh           # start server + worker(s)
#   ./job_hq.sh                      # submit one task per .xyz
#   hq job wait last                 # block until all tasks finish
#   ./job_hq.sh collect              # rebuild _summary.csv / _failed.csv

set -euo pipefail

# --- edit these ------------------------------------------------------------
FLAMMAP_DIR=/users/jzhou/git/FlamMap
INPUT_DIR=/users/jzhou/work/MSR1467/xyzfiles/C5
OUTPUT_DIR=/users/jzhou/work/MSR1467/output_1.1
CPUS_PER_TASK=4
# ---------------------------------------------------------------------------

VENV_PYTHON="$FLAMMAP_DIR/.venv/bin/python"
RUN_PY="$FLAMMAP_DIR/run.py"

# --- collect-summary mode (run after `hq job wait`) ------------------------
if [[ "${1:-}" == "collect" ]]; then
    ls "$INPUT_DIR"/*.xyz > "$OUTPUT_DIR/xyzlist.txt"
    "$VENV_PYTHON" "$RUN_PY" --collect-summary "$OUTPUT_DIR/xyzlist.txt" \
        --output-dir "$OUTPUT_DIR"
    exit 0
fi
# ---------------------------------------------------------------------------

mkdir -p "$OUTPUT_DIR"

# Cap BLAS / OMP threads to the CPU budget HQ gives each task — otherwise
# numpy/pyscf grab all cores on the node and tasks oversubscribe each other.
for xyz_file in "$INPUT_DIR"/*.xyz; do
    hq submit --cpus "$CPUS_PER_TASK" \
        --env OMP_NUM_THREADS="$CPUS_PER_TASK" \
        --env OPENBLAS_NUM_THREADS="$CPUS_PER_TASK" \
        --env MKL_NUM_THREADS="$CPUS_PER_TASK" \
        -- "$VENV_PYTHON" "$RUN_PY" "$xyz_file" \
            --output-dir "$OUTPUT_DIR" --no-plot --skip-existing
done

echo
echo "Submitted $(ls "$INPUT_DIR"/*.xyz | wc -l) tasks. Useful commands:"
echo "  hq job list                  # see jobs"
echo "  hq job info last             # detail for the batch just submitted"
echo "  hq job wait last             # block until all tasks finish"
echo "  $0 collect                   # rebuild _summary.csv after wait"
