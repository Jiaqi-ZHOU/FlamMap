#!/bin/bash
# Template SLURM batch script. Copy next to your data (NOT inside the FlamMap
# repo) and edit the knobs below.
#
#   cp /path/to/FlamMap/job.sh.example /scratch/my_project/job.sh
#   $EDITOR /scratch/my_project/job.sh
#   cd /scratch/my_project        # slurm_%j.out lands wherever you sbatch from
#   sbatch job.sh
#
#SBATCH --job-name=flammap
#SBATCH --output=slurm_%j.out
#SBATCH --error=slurm_%j.err
#SBATCH --partition=PARTITION_NAME    # e.g. workstations, jobs, compute — check `sinfo`
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=96            # number of PHYSICAL cores you want (see hint below)
#SBATCH --hint=nomultithread          # bind to physical cores only, skip HT siblings.
                                      # Dense BLAS / pyscf / torch don't benefit from
                                      # HT (two threads share one core's FMA units +
                                      # L1d cache) — for SCF+NN workloads HT often
                                      # *hurts* throughput. Remove this line if you
                                      # want HT enabled.
#SBATCH --mem=64GB                    # ~4 GB per worker × JOBS; bump if OOM-killed
#SBATCH --time=24:00:00
# # --- uncomment to request a GPU (only useful for molecules >10 heavy atoms;
# #     see device note below) ---
# #SBATCH --gres=gpu:1
# #SBATCH --partition=workstationsGPU

set -euo pipefail

# --- edit these ------------------------------------------------------------
FLAMMAP_DIR=/absolute/path/to/FlamMap        # FlamMap repo (where pyproject.toml + .venv live)
INPUT_LIST=/absolute/path/to/xyzlist.txt     # one XYZ path per line; relative paths
                                             # are resolved against this file's dir
OUTPUT_DIR=/absolute/path/to/outputs         # per-mol JSON + SUMMARY.csv + FAILED.csv
JOBS=12                                      # parallel workers; 96 cores / 8 threads = 12
LFL_THRESHOLD=1550                           # CAFT cutoff (K) for the LOWER limit
UFL_THRESHOLD=1250                           # CAFT cutoff (K) for the UPPER limit; set lower
                                             # (e.g. 1250) if calibrated differently. Equal = single cutoff.
# ---------------------------------------------------------------------------

# --- about GPU -------------------------------------------------------------
# `--skala-device` and `--hip-device` default to "auto", which works like this:
#
#   if torch.cuda.is_available() AND molecule has > 10 heavy (non-H) atoms:
#       device = cuda
#   else:
#       device = cpu
#
# So on a SLURM node without --gres=gpu:1 (the default below), CUDA is NOT
# available and every molecule runs on CPU regardless of size. For CHON
# molecules with ≤10 heavy atoms (typical of small-fuel datasets), even with
# a GPU allocated, "auto" would still pick CPU because the GPU init overhead
# (~10–15 s of cupy/gpu4pyscf setup per process) is larger than the SCF
# speedup.
#
# To force GPU regardless of size:
#   uv run ... python ... --skala-device cuda --hip-device cuda
# and uncomment the --gres / --partition lines above.
# ---------------------------------------------------------------------------

# `--project` makes uv resolve FlamMap's pyproject.toml + .venv at $FLAMMAP_DIR
# without changing this script's working directory — so slurm_%j.out stays
# wherever you ran `sbatch` from, not inside the FlamMap repo.
uv run --project "$FLAMMAP_DIR" python "$FLAMMAP_DIR/run.py" \
    --input-list "$INPUT_LIST" \
    --output-dir "$OUTPUT_DIR" \
    --jobs "$JOBS" \
    --lfl-threshold "$LFL_THRESHOLD" \
    --ufl-threshold "$UFL_THRESHOLD" \
    --no-plot \
    --skip-existing
